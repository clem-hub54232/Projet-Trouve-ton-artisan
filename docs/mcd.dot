digraph MCD {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.75", ranksep="0.9"];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=11, color="#384050", penwidth=1.3, arrowhead=none];

  categorie [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#00497c" BGCOLOR="#f1f8fc">
      <TR><TD><B>CATEGORIE</B></TD></TR>
      <TR><TD ALIGN="LEFT"># id<BR ALIGN="LEFT"/>nom<BR ALIGN="LEFT"/>slug</TD></TR>
    </TABLE>
  >];
  specialite [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#00497c" BGCOLOR="#f1f8fc">
      <TR><TD><B>SPECIALITE</B></TD></TR>
      <TR><TD ALIGN="LEFT"># id<BR ALIGN="LEFT"/>nom</TD></TR>
    </TABLE>
  >];
  artisan [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#00497c" BGCOLOR="#f1f8fc">
      <TR><TD><B>ARTISAN</B></TD></TR>
      <TR><TD ALIGN="LEFT"># id<BR ALIGN="LEFT"/>nom<BR ALIGN="LEFT"/>note<BR ALIGN="LEFT"/>ville<BR ALIGN="LEFT"/>a_propos<BR ALIGN="LEFT"/>email<BR ALIGN="LEFT"/>site_web<BR ALIGN="LEFT"/>top</TD></TR>
    </TABLE>
  >];

  categorie -> specialite [label="  CATEGORIE 1,N  -  SPECIALITE 1,1  "];
  specialite -> artisan [label="  SPECIALITE 1,N  -  ARTISAN 1,1  "];
}
